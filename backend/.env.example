# Directory holding trained artifacts (metadata.json + model files).
# Default: <repo root>/models
# PHISH_MODELS_DIR=../models

# Comma-separated list of exact browser origins allowed to call the API.
# Add your deployed frontend origin only if the backend is also publicly reachable.
PHISH_CORS_ORIGINS=http://localhost:3000

# Maximum accepted request body in bytes.
PHISH_MAX_BODY_BYTES=65536
